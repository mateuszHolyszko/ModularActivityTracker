{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "g++",
            "args": [
                "src/main.cpp",
                "src/GUI/BaseElement.cpp",
                "src/GUI/Button.cpp",
                "src/GUI/TextField.cpp",
                "src/GUI/Menu.cpp",
                "src/GUI/menus/StartMenu.cpp",
                "src/SimpleRenderer.cpp",
                "src/RenderContext.cpp",
                "src/QuadRenderer.cpp",
                "src/PostProcess.cpp",
                "external/nanovg/src/nanovg.c",
                "-o",
                "main.exe",
                "-I",
                "C:/msys64/mingw64/include/SDL2",
                "-I",
                "C:/msys64/mingw64/include",
                "-I",
                "external/nanovg/src",
                "-L",
                "C:/msys64/mingw64/lib",
                "-lmingw32",
                "-lSDL2main",
                "-lSDL2",
                "-lglew32", // For desktop OpenGL
                "-lopengl32",
                //"-lGLESv2", // Use GLESv2 instead of OpenGL for mobile
                "-lSDL2_ttf"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}